# Drupal .gitignore
# ==================

# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/
*.iml

# Ignore files generated by VSCode
/.vscode/

# Ignore Mac system files
.DS_Store
.AppleDouble
.LSOverride

# Ignore backup files
*~
*.bak
*.swp
*.swo
*.orig

# Ignore Sass cache
.sass-cache/

# Ignore node modules (si usas Node.js para temas)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Ignore compiled CSS/JS (si tienes preprocesadores)
*.css.map
*.js.map

# Ignore OS generated files
Thumbs.db
desktop.ini
.Spotlight-V100
.Trashes
ehthumbs.db

# Ignore Composer files
composer.phar
composer.lock

# Ignore PHP debug files
*.log
error_log
php_errors.log

# Ignore environment-specific files
.env
.env.local
.env.*.local

# Ignore DDEV local config
/.ddev/.gitignore
/.ddev/.ddev-docker-compose-*
/.ddev/import.yaml
/.ddev/docker-compose.*.yaml
/.ddev/db_snapshots/
/.ddev/.global_commands/
/.ddev/commands/**/
/.ddev/.homeadditions
/.ddev/.dbimageBuild

# Ignore Lando local config
/.lando.local.yml

# Ignore temporary files
/tmp/
/temp/
*.tmp

# Ignore cache directories
/.cache/
/cache/

# Ignore patches (si deseas versionarlos, coméntalos)
# /patches/

# ==========================================
# MANTENER: Archivos custom que SÍ van al repositorio
# ==========================================

# Mantener módulos custom
!/web/modules/custom/
!/web/modules/custom/**

# Mantener temas custom (incluyendo nuestro tema Santander)
!/web/themes/custom/
!/web/themes/custom/**

# Mantener perfiles custom
!/web/profiles/custom/
!/web/profiles/custom/**

# Mantener archivos de configuración del proyecto
!/web/sites/default/
!/web/sites/default/default.settings.php
!/web/sites/example.settings.local.php

# Mantener drush commands custom
!/drush/Commands/
!/drush/Commands/**

# Mantener composer.json y composer.lock
!/composer.json
!/composer.lock

# Mantener scripts y herramientas del proyecto
!/scripts/
!/scripts/**

# Mantener documentación
!/*.md
!/*.txt
!/README*
!/LICENSE*
!/CHANGELOG*

# Mantener archivos de configuración de CI/CD
!/.github/
!/.gitlab-ci.yml
!/.travis.yml
!/bitbucket-pipelines.yml

# Mantener configuración de calidad de código
!/.editorconfig
!/.eslintrc*
!/phpcs.xml*
!/phpstan.neon*
!/.php-cs-fixer.php

# ==========================================
# Archivos específicos del proyecto
# ==========================================

# Scripts de activación y documentación
!/activar-tema-santander.sh
!/activar-tema-manual.sh
!/clear-cache.php
!/disable_platform_check.php
!/ERROR_BUTTON_CORREGIDO.md
!/INSTRUCCIONES_SDC.md
!/LEEME_PRIMERO.txt
!/RESUMEN_PROYECTO.md
!/SIGUIENTE_PASO.txt
!/SOLUCION_PHP.md
!/SOLUCION_PHP.txt

# ==========================================
# Configuración de exportación/sync
# ==========================================

# Mantener directorio de configuración sincronizada
!/config/
!/config/sync/
!/config/sync/**

# ==========================================
# Excepciones para archivos del tema Santander
# ==========================================

# Asegurar que todos los archivos del tema custom se versionen
!/web/themes/custom/santander_theme/
!/web/themes/custom/santander_theme/**
!/web/themes/custom/santander_theme/components/
!/web/themes/custom/santander_theme/components/**
!/web/themes/custom/santander_theme/css/
!/web/themes/custom/santander_theme/js/
!/web/themes/custom/santander_theme/templates/

# Pero ignorar node_modules si el tema usa npm
/web/themes/custom/*/node_modules/
/web/themes/custom/*/bower_components/

# ==========================================
# Fin del .gitignore
# ==========================================
